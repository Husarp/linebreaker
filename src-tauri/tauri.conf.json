{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linebreaker",
  "version": "0.1.0",
  "identifier": "com.husarp.linebreaker",
  "build": {
    "beforeDevCommand": "node scripts/copy-web.mjs",
    "beforeBuildCommand": "node scripts/prepare-desktop-build.mjs",
    "frontendDist": "../dist-web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Linebreaker", "width": 1280, "height": 800, "minWidth": 960, "minHeight": 600, "resizable": true, "center": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser", "displayLanguageSelector": false } }
  },
  "plugins": {
    "updater": {
      "pubkey": "PLACEHOLDER_REPLACE_WITH_PUBLIC_UPDATER_KEY_BEFORE_RELEASE",
      "endpoints": ["https://github.com/Husarp/linebreaker/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
