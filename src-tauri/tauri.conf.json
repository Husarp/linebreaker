{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linebreaker",
  "version": "1.4.1",
  "identifier": "com.husarp.linebreaker",
  "build": {
    "beforeDevCommand": "npm run build:web",
    "beforeBuildCommand": "node scripts/prepare-desktop-build.mjs",
    "beforeBundleCommand": "node scripts/prepare-desktop-bundle.mjs",
    "frontendDist": "../dist-web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "create": false, "title": "Linebreaker", "width": 1280, "height": 800, "minWidth": 960, "minHeight": 600, "resizable": true, "center": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "template": "installer/setup.nsi",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZEMzI3MUFFMjI1ODMxNzgKUldSNE1WZ2lybkV5L1JUNS9kbWlnUlZ1Si9MdnNjalBucGxUK1FTWTRHZDZ3ZElKaDJuZnJPelgK",
      "endpoints": ["https://github.com/Husarp/linebreaker/releases/latest/download/latest.json"]
    }
  }
}
