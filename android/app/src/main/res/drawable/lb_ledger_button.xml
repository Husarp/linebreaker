<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/lb_ledger_disabled" />
            <corners android:radius="7dp" />
            <stroke android:width="1dp" android:color="@color/lb_ledger_rule" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/lb_ledger_track" />
            <corners android:radius="7dp" />
            <stroke android:width="2dp" android:color="@color/lb_ledger_focus" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/lb_ledger_track" />
            <corners android:radius="7dp" />
            <stroke android:width="1dp" android:color="@color/lb_ledger_label" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/lb_ledger_key" />
            <corners android:radius="7dp" />
            <stroke android:width="1dp" android:color="@color/lb_ledger_rule" />
            <padding android:top="4dp" android:bottom="4dp" android:left="8dp" android:right="8dp" />
        </shape>
    </item>
</selector>
