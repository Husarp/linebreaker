<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/lb_ledger_page</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <style name="LedgerShell" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/lb_ledger_dialog</item>
        <item name="android:colorBackground">@color/lb_ledger_panel</item>
        <item name="android:colorAccent">@color/lb_ledger_action</item>
        <item name="android:textColorPrimary">@color/lb_ledger_ink</item>
        <item name="android:textColorSecondary">@color/lb_ledger_muted</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:buttonStyle">@style/LedgerShell.Button</item>
        <item name="ledgerLabel">@color/lb_ledger_label</item>
        <item name="ledgerFocus">@color/lb_ledger_focus</item>
    </style>

    <style name="LedgerShellLight" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/lb_ledger_dialog</item>
        <item name="android:colorBackground">@color/lb_ledger_panel</item>
        <item name="android:colorAccent">@color/lb_ledger_action</item>
        <item name="android:textColorPrimary">@color/lb_ledger_ink</item>
        <item name="android:textColorSecondary">@color/lb_ledger_muted</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:buttonStyle">@style/LedgerShell.Button</item>
        <item name="ledgerLabel">@color/lb_ledger_label</item>
        <item name="ledgerFocus">@color/lb_ledger_focus</item>
    </style>

    <style name="LedgerShell.Button" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/lb_ledger_button</item>
        <item name="android:textColor">@color/lb_ledger_button_ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
</resources>
