{
  "appId": "com.husarp.linebreaker",
  "appName": "Linebreaker",
  "github": { "owner": "Husarp", "repo": "linebreaker" },
  "channels": { "bundle": "channel", "shell": "shell-channel" },
  "artifacts": { "manifest": "manifest.json", "shellManifest": "shell.json", "apk": "LinebreakerShell-{code}.apk", "asset": "f-{sha256}.bin" },
  "updateUrls": { "bundle": null, "shell": null, "releases": null },
  "build": { "shellApi": 1, "versionCode": 1402, "versionName": "1.4.2", "webVersion": "1.4.2", "minShellApi": 1, "message": "Open rewards straight from your run summary, revisit your final board, and filter your Inventory. The Season Pass, Daily Gift, and crate rewards have been rebalanced. Android updates now show their download size before you start." },
  "signing": {
    "privateKey": "~/.keystores/linebreaker/ota-private.pem",
    "publicKey": "keys/public-key.b64",
    "keystore": "~/.keystores/linebreaker/release.jks",
    "properties": "~/.keystores/linebreaker/signing.properties",
    "keyAlias": "linebreaker",
    "storePasswordEnv": "LINEBREAKER_ANDROID_STORE_PASSWORD",
    "keyPasswordEnv": "LINEBREAKER_ANDROID_KEY_PASSWORD"
  },
  "bundle": { "sourceDir": "dist-web", "baselineDir": ".local/ota-baseline/1.0.0", "baselineVersion": "1.0.0", "baselineMinShellApi": 1 }
}
